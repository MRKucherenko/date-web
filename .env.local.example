# Заведи бесплатный аккаунт на https://www.emailjs.com/
# 1. Email Services -> Add New Service -> подключи свою почту, скопируй Service ID
# 2. Email Templates -> создай шаблон ровно с тремя переменными: {{email}} {{date_type}} {{when}}
#    ({{email}} используй как "To Email" в настройках шаблона)
#    скопируй Template ID
# 3. Account -> General -> скопируй Public Key
# Впиши значения ниже, сохрани файл как .env.local (без .example) и перезапусти npm run dev

NEXT_PUBLIC_EMAILJS_SERVICE_ID=
NEXT_PUBLIC_EMAILJS_TEMPLATE_ID=
NEXT_PUBLIC_EMAILJS_PUBLIC_KEY=
